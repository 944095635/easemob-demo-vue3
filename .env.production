# 自有 API 服务地址（生产 Web / Electron 直连；跨域需服务端放行）
VITE_API_BASE_URL=https://htlv2api.cntlyun.com.cn
VITE_API_TIMEOUT=15000
# 自有 App Server 地址（登录、按手机号查用户、头像上传、注销账户等接口）
VITE_APP_SERVER_URL=https://htlv2api.cntlyun.com.cn
# 自有服务端请求签名密钥（与 Flutter Configs.httpKey 对齐，用于 X-Sign）
VITE_HTTP_SIGN_KEY=c3b6b224168533d369db2eca6e08db1058066da932e5321aaa64a6a4a696721f
# UIKit 接入：环信 AppKey（格式 xxxx#xxxx），登录 IM 初始化时使用；留空则 Provider 不自动初始化
VITE_APP_KEY="1145250718193494#ironchat"
# OSS/CDN 头像读链路：Web 生产由 nginx 配 /oss-cdn 反代、Electron 由内置反代注入 Referer
VITE_OSS_CDN_HOST=cdnv2.cntlyun.com
VITE_OSS_REFERER=https://cdnv2.cntlyun.com/
VITE_OSS_PROXY_ENABLED=true
